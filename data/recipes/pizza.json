{
  "id": "pizza",
  "name": "Pizza",

  "servings": {
    "qty": 8,
    "unit": "slice",
    "scale_method": "multiple_1_down"
  },

  "equipment": [
    {
      "qty": 1,
      "id": "sheet-pan",
	  "name": "sheet pan",
      "scale_method": "multiple_1_up"
    },
    {
      "qty": 1,
      "id": "oven",
      "scale_method": "fixed"
    },
	{
      "qty": 1,
      "id": "kitchen-shears",
	  "name": "kitchen shears",
      "scale_method": "fixed",
	  "plural": false
    },
  ],

  "ingredients": [
    { 
      "qty": { "int": 2 }, 
	  "id": "pizza-dough", 
	  "name": "pizza dough", 
	  "unit": "ball",
	  "plural": false
	},
	{
	  "options": [
		{
		  "qty": 1,
		  "id": "egg",
		  "scale_method": "fixed"
		},
		{
		  "qty": 1,
		  "unit": "oz",
		  "id": "pesto",
		  "scale_method": "multiple_1_up"
		}
	  ]
	},
    { 
	  "qty": { "num": 1, "den": 2 }, 
	  "id": "sauce", 
	  "unit": "cup", 
	  "plural": false
	},
    { 
	  "qty": { "int": 8 }, 
	  "id": "mozzarella-cheese-sliced", 
	  "name": "mozzarella cheese", 
	  "unit": "oz", 
	  "plural": false
	}
  ],

  "instructions": [
    "Butter {sheet-pan:full}.",
    "Lay {pizza-dough:full} in bag(s) on counter for 30 minutes to get to room temperature.",
    "Pre-heat the {oven} to 350\u00b0F.",
    "Spread {pizza-dough:full} across {sheet-pan:full} and let rise for 30 minutes.",
    "Coat top of dough with {egg} wash or {pesto}.",
    "Bake for 25 minutes or until crust is golden. During this time, cut {mozzarella-cheese-sliced:full} into thin slices.",
    "Add {mozzarella-cheese} pieces to pizza.",
    "Bake for an additional 10 minutes."
	"Let cool on pan for 10 minutes.",
	"Cut pizza(s) into 8 slices using {kitchen-shears}."
  ]
}